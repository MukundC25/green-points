{
  "name": "green-points-system",
  "version": "1.0.0",
  "description": "E-waste rewards system with Green Points",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "validate": "./validate_environment.sh",
    "start-with-ml": "./start_with_ml.sh",
    "setup-ml": "./setup_ml_service.sh",
    "test-integration": "node test_ml_integration.js"
  },
  "keywords": [
    "e-waste",
    "rewards",
    "green-points",
    "sustainability"
  ],
  "author": "Mukund Chavan",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "colors": "^1.4.0"
  }
}
