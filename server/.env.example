# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/green-points?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Client Configuration (Vercel Frontend)
CLIENT_URL=https://your-frontend.vercel.app

# ML Service Configuration (Render ML Service)
ML_API_URL=https://your-ml-service.onrender.com

# Session Configuration
SESSION_SECRET=green-points-session-secret-2024

# File Upload Configuration (if needed later)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (for future features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Redis Configuration (for future caching)
REDIS_URL=redis://localhost:6379
